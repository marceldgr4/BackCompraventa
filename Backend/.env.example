# ══════════════════════════════════════════════════════════════════════════════
# CompraVenta Backend — Variables de Entorno (Example)
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env y rellena o ajusta los valores necesarios:
# cp .env.example .env

# ── Perfil de Spring ─────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
# Opciones: local | production

# ── PostgreSQL LOCAL / Docker ────────────────────────────────────────────────
# En desarrollo local (host): jdbc:postgresql://localhost:5432/compraventa
# Dentro de contenedor Docker: jdbc:postgresql://db:5432/compraventa
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/compraventa
LOCAL_DB_USER=compraventa
LOCAL_DB_PASSWORD=compraventa_pass_2026

# ── pgAdmin Web Client ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@compraventa.com
PGADMIN_PASSWORD=admin123

# ── Redis (Caché + Rate Limiting) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_2026

# ── JWT Security ──────────────────────────────────────────────────────────────
# Generar clave segura de al menos 64 caracteres (por ej. con openssl rand -base64 64)
JWT_SECRET=v9y$B&E)H@sSfdoxS_K9SdfS8SdfS8dfSdfSdfSdfSdfSdf
JWT_EXPIRATION_MS=3600000          # 1 hora en ms
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 días en ms

# ── Supabase (Sincronización Offline-First) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SYNC_SIGNING_SECRET=your_sync_signing_secret
SYNC_ENABLED=false
SYNC_INTERVAL_MS=30000
SYNC_BATCH_SIZE=100

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separar múltiples orígenes con coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Servidor API ─────────────────────────────────────────────────────────────
SERVER_PORT=8080
