# ══════════════════════════════════════════════════════════════════════════════
# CompraVenta Backend — Variables de Entorno (Example)
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env y rellena los valores reales.

# ── Perfil de Spring ─────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
# Opciones: local | production

# ── PostgreSQL LOCAL ──────────────────────────────────────────────────────────
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/compraventa
LOCAL_DB_USER=your_db_user
LOCAL_DB_PASSWORD=your_db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password

# ── JWT Security ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=your_minimum_64_character_secret_key_for_hmac_sha256
JWT_EXPIRATION_MS=3600000       # 1 hora en ms
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 días en ms

# ── Supabase (Sincronización) ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SYNC_SIGNING_SECRET=your_sync_signing_secret
SYNC_ENABLED=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separar múltiples origins con coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Servidor ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080
